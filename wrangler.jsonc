{
  // Static-assets Worker: no server code. Cloudflare Workers Builds runs
  // `npx wrangler deploy` from the repo root; the build step below compiles
  // the Vite game into game/dist first, then that folder is uploaded as-is.
  "name": "output",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "cd game && npm ci && npm run build"
  },
  "assets": {
    "directory": "./game/dist",
    "not_found_handling": "single-page-application"
  }
}
