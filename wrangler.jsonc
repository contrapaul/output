{
  // Static-assets Worker: no server code. Workers Builds uses root directory
  // `game`, runs `npm run build` there, then `npx wrangler deploy`, which finds
  // this file one level up. Asset paths resolve relative to this file.
  "name": "output",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./game/dist",
    "not_found_handling": "single-page-application"
  }
}
